# Copy to backend/.env and fill in. Never commit real values.

# --- Required in production (the server refuses to use auto-generated secrets) ---
SECRET_KEY=change-me-long-random-string
JWT_SECRET_KEY=change-me-another-long-random-string
ADMIN_TOKEN=change-me-admin-token

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/

# --- Server ---
HOST=127.0.0.1
PORT=5000
FLASK_ENV=development
# Comma-separated extra origins allowed by CORS (besides localhost and the default site)
CORS_ALLOWED_ORIGINS=
# Set to 1 to enable debug-only endpoints (never in production)
ENABLE_DEBUG_ENDPOINTS=0

# --- Blockchain (optional) ---
WEB3_PROVIDER_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
MINTER_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# --- IPFS (optional) ---
IPFS_GATEWAY=
IPFS_PROJECT_ID=
IPFS_PROJECT_SECRET=

# --- Misc ---
AES_ENCRYPTION_KEY=
JWT_EXPIRATION_HOURS=168
DASHBOARD_CACHE_TIMEOUT=60
MAX_ACTIVITY_RECORDS=1000
